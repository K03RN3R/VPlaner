@inherits LayoutComponentBase

<div class="app-layout">
    <aside class="app-sidebar">
        <div class="app-brand">
                <span class="brand-mark">V</span>
                <span class="brand-name">VPlaner</span>
        </div>

        <nav class="app-nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Übersicht</NavLink>
            <NavLink class="nav-link" href="departments">Abteilungen</NavLink>
            <NavLink class="nav-link" href="persons">Personen</NavLink>
        </nav>
    </aside>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div> 
