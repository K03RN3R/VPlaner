@page "/departments"
@using VPlaner.Core.Models
@using VPlaner.Infrastructure.Services
@inject DepartmentService DeptSvc

<PageTitle>Abteilungen</PageTitle>

<h1>Abteilungen</h1>

<!-- Formular zum Anlegen -->
<div style="margin: 1rem 0; display: flex; gap: 0.5rem; align-items: center;">
    <input @bind="_newName"
           @bind:event="oninput"
           @onkeydown="OnKeyDown"
           placeholder="Name der neuen Abteilung"
           style="padding: 0.4rem; flex: 1; max-width: 300px;" />
    <button @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">
        Anlegen
    </button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 0.6rem; background: #e0f0ff; border-left: 4px solid #2563eb; margin: 1rem 0;">
        @_message
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div style="padding: 0.6rem; background: #ffe0e0; border-left: 4px solid #dc2626; margin: 1rem 0;">
        @_error
    </div>
}

<!-- Liste -->
@if (_departments == null)
{
    <p>Lade Daten…</p>
}
else if (_departments.Count == 0)
{
    <p>Noch keine Abteilungen angelegt.</p>
}
else
{
    <table style="width: 100%; max-width: 700px; border-collapse: collapse;">
        <thead>
            <tr style="background: #f3f3f3;">
                <th style="text-align: left; padding: 0.4rem; border-bottom: 1px solid #ccc;">ID</th>
                <th style="text-align: left; padding: 0.4rem; border-bottom: 1px solid #ccc;">Name</th>
                <th style="text-align: left; padding: 0.4rem; border-bottom: 1px solid #ccc;">Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in _departments)
            {
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 0.4rem;">@d.Id</td>
                    <td style="padding: 0.4rem;">
                        @if (_editingId == d.Id)
                        {
                            <input @bind="_editName" style="padding: 0.3rem;" />
                        }
                        else
                        {
                            @d.Name
                        }
                    </td>
                    <td style="padding: 0.4rem;">
                        @if (_editingId == d.Id)
                        {
                            <button @onclick="() => SaveAsync(d.Id)">Speichern</button>
                            <button @onclick="CancelEdit">Abbrechen</button>
                        }
                        else
                        {
                            <button @onclick="() => StartEdit(d)">Umbenennen</button>
                            <button @onclick="() => DeleteAsync(d.Id)" style="background: #fee; color: #c00;">Löschen</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Department>? _departments;
    private string _newName = string.Empty;

    private int _editingId;
    private string _editName = string.Empty;

    private string _message = string.Empty;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _departments = await DeptSvc.GetAllAsync();
    }

    private async Task CreateAsync()
    {
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            var dept = await DeptSvc.CreateAsync(_newName);
            _message = $"Abteilung '{dept.Name}' angelegt.";
            _newName = string.Empty;
            await ReloadAsync();
        }
        catch (DepartmentServiceException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateAsync();
    }

    private void StartEdit(Department d)
    {
        _editingId = d.Id;
        _editName = d.Name;
        _message = string.Empty;
        _error = string.Empty;
    }

    private void CancelEdit()
    {
        _editingId = 0;
        _editName = string.Empty;
    }

    private async Task SaveAsync(int id)
    {
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            await DeptSvc.RenameAsync(id, _editName);
            _message = "Abteilung umbenannt.";
            _editingId = 0;
            await ReloadAsync();
        }
        catch (DepartmentServiceException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _message = string.Empty;
        _error = string.Empty;

        try
        {
            await DeptSvc.DeleteAsync(id);
            _message = "Abteilung gelöscht.";
            await ReloadAsync();
        }
        catch (DepartmentServiceException ex)
        {
            _error = ex.Message;
        }
    }
}